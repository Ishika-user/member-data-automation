# Copy this file to .env and fill in values for your own environment.
# Never commit the real .env file to version control.

# SQL Server connection string (SQLAlchemy format), e.g.:
# mssql+pyodbc://user:password@host:1433/database?driver=ODBC+Driver+17+for+SQL+Server
SQL_CONNECTION_STRING=

# Target table for the optional SQL Server load module
SQL_TARGET_TABLE=Member

# Must be explicitly set to "true", together with the --load-sql CLI flag,
# before any SQL Server load will be attempted. Defaults to false.
ALLOW_SQL_LOAD=false
